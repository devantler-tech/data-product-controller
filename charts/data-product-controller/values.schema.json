{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "connectorReadiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "httpSource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string" },
        "sourceCIDR": { "type": "string" },
        "consumerPodLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "monitorPodLabels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "resources": { "type": "object" }
      },
      "if": {
        "properties": { "enabled": { "const": true } },
        "required": ["enabled"]
      },
      "then": {
        "required": ["secretName", "sourceCIDR", "consumerPodLabels"],
        "properties": {
          "secretName": {
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "sourceCIDR": {
            "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}/32$"
          },
          "consumerPodLabels": { "minProperties": 1 }
        }
      }
    }
  }
}
