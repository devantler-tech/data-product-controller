{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:data-product-preflight:v2",
  "title": "Offline publisher report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "valid",
    "complete",
    "products",
    "sources",
    "requiredFeatures",
    "productFeatures",
    "diagnostics",
    "diagnosticCounts",
    "descriptors",
    "plan"
  ],
  "properties": {
    "apiVersion": {
      "const": "data-product-preflight/v2"
    },
    "valid": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "products": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "sources": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "documents",
          "products"
        ],
        "properties": {
          "source": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "documents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4097
          },
          "products": {
            "type": "integer",
            "minimum": 0,
            "maximum": 256
          }
        }
      }
    },
    "requiredFeatures": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "provisioned-sources",
          "engine-providers",
          "connector-readiness",
          "composition",
          "contract-readiness",
          "ui-contract",
          "ui-appearance",
          "dcat-catalog"
        ]
      }
    },
    "productFeatures": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "document",
          "requiredFeatures"
        ],
        "properties": {
          "source": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "document": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4097
          },
          "requiredFeatures": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "provisioned-sources",
                "engine-providers",
                "connector-readiness",
                "composition",
                "contract-readiness",
                "ui-contract",
                "ui-appearance",
                "dcat-catalog"
              ]
            }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "document",
          "line",
          "column",
          "severity",
          "code",
          "path",
          "message",
          "witness",
          "witnessTruncated"
        ],
        "properties": {
          "source": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32
          },
          "document": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4097
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097153
          },
          "column": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2097153
          },
          "severity": {
            "enum": [
              "error",
              "warning"
            ]
          },
          "code": {
            "enum": [
              "NoProducts",
              "SourceLimit",
              "DocumentLimit",
              "ReadFailed",
              "InputLimit",
              "ProductLimit",
              "DepthLimit",
              "InvalidDocument",
              "UnsupportedResource",
              "UnknownField",
              "AdmissionInvalid",
              "NamespaceRequired",
              "InvalidNamespace",
              "IdentityConflict",
              "InvalidPublicMetadata",
              "InvalidUI",
              "ContractOutputNotFound",
              "ProducerUnresolved",
              "OutputNotFound",
              "ContractIncompatible",
              "CrossNamespaceInput",
              "CompositionCycle",
              "CompositionLimit",
              "ValidationLimit",
              "ValidationUnavailable",
              "PreviewLimit",
              "InvalidField",
              "RequiredField",
              "DuplicateListItem",
              "CrossFieldInvalid"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(|/(apiVersion|kind|metadata|spec)(/[A-Za-z][A-Za-z0-9]*|/[0-9]+)*)$"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "witness": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "document",
                "path"
              ],
              "properties": {
                "source": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "document": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4097
                },
                "path": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^(|/(apiVersion|kind|metadata|spec)(/[A-Za-z][A-Za-z0-9]*|/[0-9]+)*)$"
                }
              }
            }
          },
          "witnessTruncated": {
            "type": "boolean"
          }
        }
      }
    },
    "diagnosticCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total",
        "errors",
        "warnings",
        "omitted"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "warnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "omitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "descriptors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "allOf": [
          {
            "$ref": "urn:data-product-descriptor:v1"
          },
          {
            "properties": {
              "ready": {
                "const": false
              },
              "generation": {
                "const": 0
              },
              "observedGeneration": {
                "const": 0
              },
              "readiness": {
                "properties": {
                  "reason": {
                    "const": "unobserved"
                  }
                }
              },
              "health": {
                "additionalProperties": {
                  "properties": {
                    "state": {
                      "enum": [
                        "unobserved",
                        "not-applicable"
                      ]
                    },
                    "generation": {
                      "const": 0
                    },
                    "observedGeneration": {
                      "const": 0
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/plan"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "valid": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "descriptors": {
            "maxItems": 0
          },
          "plan": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "valid": {
            "const": true
          },
          "products": {
            "minimum": 1
          },
          "sources": {
            "minItems": 1
          },
          "productFeatures": {
            "minItems": 1
          },
          "descriptors": {
            "minItems": 1
          },
          "plan": {
            "$ref": "#/$defs/plan"
          }
        }
      }
    }
  ],
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "edges"
      ],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "source",
              "document"
            ],
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 317,
                "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9.-]*$"
              },
              "source": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "document": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4097
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "consumer",
              "producer",
              "input",
              "inputIndex",
              "output",
              "source",
              "document"
            ],
            "properties": {
              "consumer": {
                "type": "string",
                "maxLength": 317,
                "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9.-]*$"
              },
              "producer": {
                "type": "string",
                "maxLength": 317,
                "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9.-]*$"
              },
              "input": {
                "type": "string",
                "maxLength": 63,
                "minLength": 1
              },
              "inputIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              },
              "output": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "source": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "document": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4097
              }
            }
          }
        }
      }
    }
  }
}
