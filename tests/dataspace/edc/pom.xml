<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>tech.devantler.khoist.acceptance</groupId>
  <artifactId>edc-import</artifactId>
  <version>1.0.0</version>
  <description>Independent offline Eclipse EDC catalog import acceptance only.</description>
  <properties>
    <edc.version>0.18.1</edc.version>
    <jackson.version>2.21.7</jackson.version>
    <opentelemetry.version>1.62.0</opentelemetry.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>json-ld-lib</artifactId>
      <version>${edc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>json-lib</artifactId>
      <version>${edc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>transform-lib</artifactId>
      <version>${edc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>dsp-catalog-transform-2025</artifactId>
      <version>${edc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>dsp-catalog-transform-lib</artifactId>
      <version>${edc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.edc</groupId>
      <artifactId>control-plane-transform</artifactId>
      <version>${edc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.parsson</groupId>
      <artifactId>parsson</artifactId>
      <version>1.1.7</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
